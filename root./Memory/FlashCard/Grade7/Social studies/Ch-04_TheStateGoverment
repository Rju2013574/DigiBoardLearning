<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Grade 7 Social Studies: The State Government Flashcards</title>
  <style>
    :root {
      --bg-main: #0f172a;
      --surface-card: #1e293b;
      --surface-back: #172554;
      --border-back: #2563eb;
      --accent-primary: #38bdf8;
      --accent-success: #4ade80;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      height: 100dvh;
      width: 100vw;
      overflow: hidden;
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .container {
      width: 100%;
      max-width: 1120px;
      height: 100dvh;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(0.5rem, 2vh, 1.25rem) clamp(0.75rem, 2vw, 1.5rem);
      gap: clamp(0.4rem, 1.2vh, 0.8rem);
    }

    /* HEADER & BRAND */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .brand h1 {
      font-size: clamp(1.1rem, 2vw, 1.5rem);
      font-weight: 800;
      color: var(--accent-primary);
      letter-spacing: -0.02em;
    }

    .brand p {
      font-size: clamp(0.75rem, 1.2vw, 0.875rem);
      color: var(--text-muted);
    }

    /* TOOLBAR & CONTROLS */
    .toolbar-row {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      flex-wrap: nowrap;
      flex-shrink: 0;
    }

    .controls-group {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: nowrap;
    }

    select, button {
      background: var(--surface-card);
      color: var(--text-main);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      font-size: clamp(0.75rem, 1.1vw, 0.85rem);
      padding: 0 0.5rem;
      cursor: pointer;
      outline: none;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      white-space: nowrap;
    }

    select {
      height: 32px;
      max-width: 155px;
      text-overflow: ellipsis;
    }

    button {
      height: 32px;
      padding: 0 0.65rem;
      font-weight: 600;
    }

    button:hover, select:hover {
      border-color: var(--accent-primary);
      background: #26334d;
    }

    button:active {
      transform: scale(0.96);
    }

    /* PROGRESS HEADER & BAR */
    .progress-section {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      flex-shrink: 0;
    }

    .stats-header {
      display: flex;
      justify-content: space-between;
      font-size: clamp(0.75rem, 1.2vw, 0.85rem);
      color: var(--text-muted);
      font-weight: 500;
    }

    .progress-bar-bg {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent-primary), var(--accent-success));
      transition: width 0.3s ease;
    }

    /* FLASHCARD SCENE */
    .flashcard-scene {
      flex: 1;
      min-height: 0;
      perspective: 1200px;
      position: relative;
      width: 100%;
    }

    .card {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      border-radius: 14px;
    }

    .card.is-flipped {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: 14px;
      padding: clamp(1rem, 3vh, 2rem) clamp(1rem, 3vw, 2.5rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
    }

    .card-front {
      background-color: var(--surface-card);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card-back {
      background-color: var(--surface-back);
      border: 2px solid var(--border-back);
      transform: rotateY(180deg);
    }

    .card-tag {
      align-self: flex-start;
      font-size: clamp(0.7rem, 1vw, 0.8rem);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
      color: var(--accent-primary);
      background: rgba(56, 189, 248, 0.1);
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
    }

    .card-body {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0.5rem 0;
      overflow: hidden;
    }

    .question-text {
      font-size: clamp(1.15rem, 2.3vw, 1.7rem);
      font-weight: 700;
      text-align: center;
      color: var(--text-main);
      line-height: 1.35;
    }

    .answer-inner {
      width: 100%;
      max-height: 100%;
      overflow-y: auto;
      text-align: left;
      font-size: clamp(0.95rem, 1.4vw, 1.15rem);
      line-height: 1.6;
      color: #e2e8f0;
      padding-right: 0.3rem;
      user-select: text;
      -webkit-user-select: text;
    }

    .answer-inner ul, .answer-inner ol {
      margin-left: 1.2rem;
      margin-top: 0.4rem;
    }

    .answer-inner li {
      margin-bottom: 0.3rem;
    }

    .answer-inner code {
      background: rgba(0, 0, 0, 0.3);
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
      font-family: monospace;
      color: var(--accent-primary);
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      flex-shrink: 0;
    }

    .flip-hint {
      font-size: clamp(0.7rem, 1vw, 0.8rem);
      color: var(--text-muted);
    }

    .btn-mastery {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: var(--text-main);
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: clamp(0.75rem, 1vw, 0.85rem);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-mastery.mastered {
      background: var(--accent-success);
      color: #0f172a;
      border-color: var(--accent-success);
    }

    /* NAVIGATION BUTTONS */
    .nav-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .nav-btn {
      flex: 1;
      height: 40px;
      font-size: clamp(0.85rem, 1.2vw, 1rem);
      font-weight: 700;
      background: var(--surface-card);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .shortcuts-legend {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-align: center;
      flex-shrink: 0;
    }

    .shortcuts-legend kbd {
      background: rgba(255, 255, 255, 0.1);
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      font-family: monospace;
    }

    /* SWIPE BADGES & ANIMATIONS */
    .swipe-badge {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      padding: 0.5rem 1rem;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid var(--accent-primary);
      color: var(--accent-primary);
      border-radius: 8px;
      font-weight: bold;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s ease;
      z-index: 10;
    }

    .swipe-badge.left { left: 1rem; }
    .swipe-badge.right { right: 1rem; }

    @keyframes slideLeft {
      0% { transform: translateX(0); opacity: 1; }
      50% { transform: translateX(-40px); opacity: 0.3; }
      100% { transform: translateX(0); opacity: 1; }
    }

    @keyframes slideRight {
      0% { transform: translateX(0); opacity: 1; }
      50% { transform: translateX(40px); opacity: 0.3; }
      100% { transform: translateX(0); opacity: 1; }
    }

    .slide-left { animation: slideLeft 0.35s ease; }
    .slide-right { animation: slideRight 0.35s ease; }

    /* MOBILE OPTIMIZATIONS */
    @media (max-width: 640px) {
      .brand p { display: none; }
      .btn-label { display: none; }
      .shortcuts-legend { display: none; }
      select { height: 28px; max-width: 115px; }
      button { height: 28px; padding: 0 0.4rem; }
      .nav-btn { height: 36px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header>
      <div class="brand">
        <h1>Civics Study Deck</h1>
        <p>Grade 7 Social Studies: The State Government</p>
      </div>
    </header>

    <!-- Controls Row -->
    <div class="toolbar-row">
      <div class="controls-group">
        <select id="topicFilter" aria-label="Filter Topic">
          <option value="ALL">All Topics</option>
          <option value="Structure">Structure</option>
          <option value="Vidhan Sabha">Vidhan Sabha</option>
          <option value="Vidhan Parishad">Vidhan Parishad</option>
          <option value="Legislative Powers">Powers & Bills</option>
          <option value="Governor & CM">Governor & CM</option>
        </select>
        <select id="masteryFilter" aria-label="Filter Mastery">
          <option value="ALL">All Cards</option>
          <option value="UNMASTERED">Learning</option>
          <option value="MASTERED">Mastered</option>
        </select>
      </div>
      <div class="controls-group">
        <button id="btnShuffle" title="Shuffle Cards (S)"><span class="btn-icon">🔀</span><span class="btn-label">Shuffle</span></button>
        <button id="btnReset" title="Reset Progress"><span class="btn-icon">🔄</span><span class="btn-label">Reset</span></button>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-section">
      <div class="stats-header">
        <span id="cardCounter">Card 1 of 20</span>
        <span id="masteryStats">0% Mastered (0/20)</span>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progressBar"></div>
      </div>
    </div>

    <!-- Flashcard Scene -->
    <div class="flashcard-scene" id="scene">
      <div class="swipe-badge left" id="badgePrev">← Previous</div>
      <div class="swipe-badge right" id="badgeNext">Next →</div>

      <div class="card" id="card">
        <!-- Front -->
        <div class="card-face card-front">
          <span class="card-tag" id="cardTag">Topic</span>
          <div class="card-body">
            <h2 class="question-text" id="questionText">Question</h2>
          </div>
          <div class="card-footer">
            <span class="flip-hint">👆 Tap / Press Space to Flip</span>
            <button class="btn-mastery" id="btnMasteryFront">Mark Mastered</button>
          </div>
        </div>

        <!-- Back -->
        <div class="card-face card-back">
          <span class="card-tag" id="cardTagBack">Topic</span>
          <div class="card-body">
            <div class="answer-inner" id="answerText">Answer</div>
          </div>
          <div class="card-footer">
            <span class="flip-hint">👆 Tap to Flip Back</span>
            <button class="btn-mastery" id="btnMasteryBack">Mark Mastered</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Row -->
    <div class="nav-row">
      <button class="nav-btn" id="btnPrev">← Prev</button>
      <button class="nav-btn" id="btnNext">Next →</button>
    </div>

    <!-- Shortcuts Footer -->
    <div class="shortcuts-legend">
      Shortcuts: <kbd>Space</kbd> Flip | <kbd>←</kbd> <kbd>→</kbd> Navigate | <kbd>M</kbd> Mastery | <kbd>S</kbd> Shuffle
    </div>
  </div>

  <script>
    const flashcards = [
      {
        id: "card_1",
        topic: "Structure",
        question: "What are the three main levels of government in India?",
        answer: "<ol><li><b>Central / Union Government:</b> Governs the whole country from New Delhi.</li><li><b>State Government:</b> Governs individual states (e.g., Karnataka, UP).</li><li><b>Local Government:</b> Operates at local levels (Panchayats & Municipalities).</li></ol>"
      },
      {
        id: "card_2",
        topic: "Structure",
        question: "What is the difference between a Unicameral and a Bicameral Legislature?",
        answer: "<ul><li><b>Unicameral Legislature:</b> A state legislature with only <b>one house</b>—the Legislative Assembly (Vidhan Sabha).</li><li><b>Bicameral Legislature:</b> A state legislature with <b>two houses</b>—the Legislative Assembly (Vidhan Sabha) and Legislative Council (Vidhan Parishad).</li></ul>"
      },
      {
        id: "card_3",
        topic: "Vidhan Sabha",
        question: "What is the Legislative Assembly (Vidhan Sabha) and what are its strength limits?",
        answer: "The Vidhan Sabha is the <b>Lower House</b> of the state legislature, representing the people directly.<br><br><b>Strength Limits:</b> Maximum <b>500 members</b> and minimum <b>60 members</b> (smaller states have exceptions)."
      },
      {
        id: "card_4",
        topic: "Vidhan Sabha",
        question: "What are the qualifications required to become an MLA?",
        answer: "To become a Member of the Legislative Assembly (MLA), a candidate must:<ul><li>Be a <b>citizen of India</b>.</li><li>Be registered as a voter in that state.</li><li>Be at least <b>25 years of age</b>.</li><li>Be mentally sound and solvent (not bankrupt).</li><li>Not hold any office of profit under the government.</li></ul>"
      },
      {
        id: "card_5",
        topic: "Vidhan Sabha",
        question: "Who presides over the sittings of the Legislative Assembly?",
        answer: "The <b>Speaker</b> (elected by the members of the Vidhan Sabha from among themselves) presides over meetings, maintains order, and conducts proceedings. The <b>Deputy Speaker</b> acts in their absence."
      },
      {
        id: "card_6",
        topic: "Vidhan Parishad",
        question: "What is the Legislative Council (Vidhan Parishad)?",
        answer: "The Vidhan Parishad is the <b>Upper House</b> of the State Legislature. It is a <b>permanent body</b> and cannot be dissolved. Members serve <b>6-year terms</b>, with $\\frac{1}{3}\\text{rd}$ of members retiring every 2 years."
      },
      {
        id: "card_7",
        topic: "Vidhan Parishad",
        question: "How are members of the Vidhan Parishad (MLCs) chosen?",
        answer: "MLCs are indirectly elected & nominated:<ul><li><b>1/3rd</b> elected by local bodies (Municipalities, District Boards).</li><li><b>1/3rd</b> elected by MLAs.</li><li><b>1/12th</b> elected by Registered Graduates.</li><li><b>1/12th</b> elected by Teachers.</li><li><b>1/6th</b> nominated by the Governor (specialists in art, science, literature, social service).</li></ul>"
      },
      {
        id: "card_8",
        topic: "Vidhan Parishad",
        question: "What are the age and strength rules for Vidhan Parishad?",
        answer: "<ul><li><b>Minimum Age:</b> Must be at least <b>30 years</b> old.</li><li><b>Total Strength:</b> Cannot exceed <b>$\\frac{1}{3}\\text{rd}$</b> of the total assembly strength of that state, and cannot be less than <b>40 members</b>.</li></ul>"
      },
      {
        id: "card_9",
        topic: "Legislative Powers",
        question: "What subjects can the State Legislature make laws on?",
        answer: "<ul><li><b>State List (61 subjects):</b> Police, Agriculture, Irrigation, Public Health, Land Revenue.</li><li><b>Concurrent List (52 subjects):</b> Education, Forests, Trade Unions, Marriage. <i>(Note: If Union & State laws conflict, Central law prevails).</i></li></ul>"
      },
      {
        id: "card_10",
        topic: "Legislative Powers",
        question: "What is the difference between an Ordinary Bill and a Money Bill?",
        answer: "<ul><li><b>Ordinary Bill:</b> Deals with general laws; can originate in <b>either House</b> (Vidhan Sabha or Vidhan Parishad).</li><li><b>Money Bill:</b> Deals with taxes, government revenue & spending; can <b>ONLY originate in Vidhan Sabha</b> with prior consent of the Governor.</li></ul>"
      },
      {
        id: "card_11",
        topic: "Legislative Powers",
        question: "What are the Three Readings of a Bill?",
        answer: "<ol><li><b>First Reading:</b> Introduction of the bill and explanation of its objectives.</li><li><b>Second Reading:</b> General discussion, clause-by-clause scrutiny, debate, and potential committee review.</li><li><b>Third Reading:</b> Final voting on the bill.</li></ol>"
      },
      {
        id: "card_12",
        topic: "Legislative Powers",
        question: "How long can the Legislative Council delay a Money Bill vs. an Ordinary Bill?",
        answer: "<ul><li><b>Money Bill:</b> Can only be delayed for maximum <b>14 days</b>.</li><li><b>Ordinary Bill:</b> Can be retained for <b>3 months</b> on first receipt, and <b>1 month</b> if sent back again (Maximum delay = 4 months).</li></ul>"
      },
      {
        id: "card_13",
        topic: "Governor & CM",
        question: "Who is the Governor and how are they appointed?",
        answer: "The Governor is the <b>Constitutional Head of the State</b> and representative of the Central Government.<br><br>Appointed by the <b>President of India</b> (on PM's advice) for a <b>5-year term</b> and holds office during the pleasure of the President."
      },
      {
        id: "card_14",
        topic: "Governor & CM",
        question: "What are the essential qualifications to become a Governor?",
        answer: "A Governor candidate must:<ul><li>Be a <b>citizen of India</b>.</li><li>Be at least <b>35 years of age</b>.</li><li>Not be a member of Parliament or State Legislature.</li><li>Not hold any office of profit under the government.</li></ul>"
      },
      {
        id: "card_15",
        topic: "Governor & CM",
        question: "What are the Executive Powers of the Governor?",
        answer: "The Governor appoints:<ul><li>The <b>Chief Minister</b> and Council of Ministers.</li><li>The <b>Advocate General</b> of the state.</li><li>Chairman and members of State Public Service Commission.</li><li>Judges of subordinate courts (consulted for High Court judges).</li></ul>"
      },
      {
        id: "card_16",
        topic: "Governor & CM",
        question: "What are the Discretionary Powers of the Governor?",
        answer: "Powers exercised at the Governor's own discretion:<ul><li>Recommending <b>President's Rule (Article 356)</b> in case of breakdown of constitutional machinery.</li><li>Choosing the Chief Minister in case of a hung assembly.</li><li>Reserving specific Bills for the President's consideration.</li></ul>"
      },
      {
        id: "card_17",
        topic: "Governor & CM",
        question: "What is an Ordinance?",
        answer: "An <b>Ordinance</b> is a temporary law issued/promulgated by the <b>Governor</b> when the State Legislature is not in session. It must be approved by the legislature once it reassembles."
      },
      {
        id: "card_18",
        topic: "Governor & CM",
        question: "Who is the Chief Minister and how are they appointed?",
        answer: "The Chief Minister is the <b>Head of Government</b> and real executive head.<br><br>The Governor appoints the leader of the majority party in the Legislative Assembly as the Chief Minister."
      },
      {
        id: "card_19",
        topic: "Governor & CM",
        question: "What are the main functions of the Chief Minister?",
        answer: "<ul><li>Recommends ministers for appointment to the Governor.</li><li>Allocates and reshuffles portfolios (departments).</li><li>Presides over Cabinet meetings.</li><li>Acts as the primary link between the Governor and Council of Ministers.</li></ul>"
      },
      {
        id: "card_20",
        topic: "Structure",
        question: "What is Article 356 (President's Rule)?",
        answer: "<b>Article 356</b> allows the President of India to suspend state government administration and impose direct Union control when state government fails to function according to constitutional provisions, based on the Governor's report."
      }
    ];

    // State Variables
    let currentCards = [...flashcards];
    let currentIndex = 0;
    let isFlipped = false;
    let masteredIds = new Set(JSON.parse(localStorage.getItem('civics_g7_mastered') || '[]'));

    // DOM Elements
    const scene = document.getElementById('scene');
    const card = document.getElementById('card');
    const questionText = document.getElementById('questionText');
    const answerText = document.getElementById('answerText');
    const cardTag = document.getElementById('cardTag');
    const cardTagBack = document.getElementById('cardTagBack');
    const cardCounter = document.getElementById('cardCounter');
    const masteryStats = document.getElementById('masteryStats');
    const progressBar = document.getElementById('progressBar');
    const topicFilter = document.getElementById('topicFilter');
    const masteryFilter = document.getElementById('masteryFilter');
    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    const btnShuffle = document.getElementById('btnShuffle');
    const btnReset = document.getElementById('btnReset');
    const btnMasteryFront = document.getElementById('btnMasteryFront');
    const btnMasteryBack = document.getElementById('btnMasteryBack');
    const badgePrev = document.getElementById('badgePrev');
    const badgeNext = document.getElementById('badgeNext');

    // Save Mastery
    function saveMastery() {
      localStorage.setItem('civics_g7_mastered', JSON.stringify([...masteredIds]));
      updateStats();
    }

    // Filter Logic
    function applyFilters() {
      const topic = topicFilter.value;
      const mastery = masteryFilter.value;

      currentCards = flashcards.filter(c => {
        const matchTopic = (topic === 'ALL' || c.topic === topic);
        const isM = masteredIds.has(c.id);
        const matchMastery = (mastery === 'ALL') || 
                             (mastery === 'MASTERED' && isM) || 
                             (mastery === 'UNMASTERED' && !isM);
        return matchTopic && matchMastery;
      });

      currentIndex = 0;
      isFlipped = false;
      card.classList.remove('is-flipped');
      renderCard();
      updateStats();
    }

    // Render Card
    function renderCard() {
      if (currentCards.length === 0) {
        questionText.textContent = "No flashcards match the selected filters.";
        answerText.innerHTML = "Try resetting filters or changing selection.";
        cardTag.textContent = "Empty";
        cardTagBack.textContent = "Empty";
        cardCounter.textContent = "Card 0 of 0";
        btnMasteryFront.style.display = 'none';
        btnMasteryBack.style.display = 'none';
        return;
      }

      btnMasteryFront.style.display = 'inline-block';
      btnMasteryBack.style.display = 'inline-block';

      const item = currentCards[currentIndex];
      questionText.textContent = item.question;
      answerText.innerHTML = item.answer;
      cardTag.textContent = item.topic;
      cardTagBack.textContent = item.topic;
      cardCounter.textContent = `Card ${currentIndex + 1} of ${currentCards.length}`;

      const isM = masteredIds.has(item.id);
      [btnMasteryFront, btnMasteryBack].forEach(btn => {
        if (isM) {
          btn.classList.add('mastered');
          btn.textContent = '✓ Mastered';
        } else {
          btn.classList.remove('mastered');
          btn.textContent = 'Mark Mastered';
        }
      });
    }

    // Update Stats & Progress Bar
    function updateStats() {
      const total = flashcards.length;
      const mCount = masteredIds.size;
      const pct = Math.round((mCount / total) * 100);
      masteryStats.textContent = `${pct}% Mastered (${mCount}/${total})`;
      progressBar.style.width = `${pct}%`;
    }

    // Flip Card
    function toggleFlip() {
      if (currentCards.length === 0) return;
      isFlipped = !isFlipped;
      card.classList.toggle('is-flipped', isFlipped);
    }

    // Navigation
    function prevCard() {
      if (currentCards.length <= 1) return;
      card.classList.remove('is-flipped');
      isFlipped = false;
      scene.classList.add('slide-right');
      setTimeout(() => scene.classList.remove('slide-right'), 350);
      currentIndex = (currentIndex - 1 + currentCards.length) % currentCards.length;
      renderCard();
    }

    function nextCard() {
      if (currentCards.length <= 1) return;
      card.classList.remove('is-flipped');
      isFlipped = false;
      scene.classList.add('slide-left');
      setTimeout(() => scene.classList.remove('slide-left'), 350);
      currentIndex = (currentIndex + 1) % currentCards.length;
      renderCard();
    }

    // Mastery Toggle
    function toggleMastery(e) {
      if (e) e.stopPropagation();
      if (currentCards.length === 0) return;
      const item = currentCards[currentIndex];
      if (masteredIds.has(item.id)) {
        masteredIds.delete(item.id);
      } else {
        masteredIds.add(item.id);
      }
      saveMastery();
      if (masteryFilter.value !== 'ALL') {
        applyFilters();
      } else {
        renderCard();
      }
    }

    // Event Listeners
    card.addEventListener('click', (e) => {
      if (e.target.closest('.btn-mastery') || e.target.closest('.answer-inner')) return;
      toggleFlip();
    });

    btnPrev.addEventListener('click', prevCard);
    btnNext.addEventListener('click', nextCard);

    [btnMasteryFront, btnMasteryBack].forEach(btn => {
      btn.addEventListener('click', toggleMastery);
    });

    topicFilter.addEventListener('change', applyFilters);
    masteryFilter.addEventListener('change', applyFilters);

    btnShuffle.addEventListener('click', () => {
      for (let i = currentCards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [currentCards[i], currentCards[j]] = [currentCards[j], currentCards[i]];
      }
      currentIndex = 0;
      isFlipped = false;
      card.classList.remove('is-flipped');
      renderCard();
    });

    btnReset.addEventListener('click', () => {
      if (confirm('Reset all mastery progress for this lesson?')) {
        masteredIds.clear();
        saveMastery();
        applyFilters();
      }
    });

    // Touch & Mouse Drag Swipe Setup
    let startX = 0;
    let dragDistance = 0;
    let isDragging = false;

    function handleStart(x) {
      startX = x;
      dragDistance = 0;
      isDragging = true;
    }

    function handleMove(x) {
      if (!isDragging) return;
      dragDistance = x - startX;
      if (dragDistance > 40) {
        badgePrev.style.opacity = Math.min((dragDistance - 40) / 60, 1);
        badgeNext.style.opacity = 0;
      } else if (dragDistance < -40) {
        badgeNext.style.opacity = Math.min((-dragDistance - 40) / 60, 1);
        badgePrev.style.opacity = 0;
      } else {
        badgePrev.style.opacity = 0;
        badgeNext.style.opacity = 0;
      }
    }

    function handleEnd() {
      if (!isDragging) return;
      isDragging = false;
      badgePrev.style.opacity = 0;
      badgeNext.style.opacity = 0;

      if (dragDistance > 70) {
        prevCard();
      } else if (dragDistance < -70) {
        nextCard();
      }
    }

    // Touch Events
    scene.addEventListener('touchstart', (e) => handleStart(e.touches[0].clientX), { passive: true });
    scene.addEventListener('touchmove', (e) => handleMove(e.touches[0].clientX), { passive: true });
    scene.addEventListener('touchend', handleEnd);

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'SELECT' || e.target.tagName === 'INPUT') return;
      if (e.code === 'Space' || e.code === 'Enter') {
        e.preventDefault();
        toggleFlip();
      } else if (e.code === 'ArrowLeft') {
        prevCard();
      } else if (e.code === 'ArrowRight') {
        nextCard();
      } else if (e.code === 'KeyM') {
        toggleMastery();
      } else if (e.code === 'KeyS') {
        btnShuffle.click();
      }
    });

    // Initialize App
    renderCard();
    updateStats();
  </script>
</body>
</html>
